# Frontend environment. Copy to `frontend/.env.local` (git-ignored by Vite) and
# fill in the two values from your Supabase project:
#   Dashboard -> Project Settings -> API
#
# Vite only exposes variables prefixed with VITE_ to the browser, and anything in
# the browser is public. The anon key is safe to ship: row level security in
# supabase/migrations/001_init.sql is what keeps candidates out of each other's
# data. Never put the service_role key in here.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

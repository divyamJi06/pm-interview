# Copy this file to .env and fill in the key for the provider you use.
# The app auto-loads .env from the project root on startup.

# Which provider to use: cohere (default) | openai | groq | anthropic
AI_PROVIDER=cohere

# Set only the line matching AI_PROVIDER:
COHERE_API_KEY=your-cohere-key
OPENAI_API_KEY=your-openai-key
GROQ_API_KEY=your-groq-key
ANTHROPIC_API_KEY=your-anthropic-key

# Optional: override the provider's default model
# COHERE_MODEL=command-a-plus-05-2026
# OPENAI_MODEL=gpt-4.1-mini
# GROQ_MODEL=llama-3.3-70b-versatile
# ANTHROPIC_MODEL=claude-sonnet-5
# AI_MODEL=model-overrides-all-of-the-above

# ---- Voice input (speech-to-text answers) ----
# Set a Deepgram API key to enable the mic button in the chat. You can speak
# an answer instead of typing it; the transcript is edited in the answer box
# before sending. Without a key the mic button stays disabled.
DEEPGRAM_API_KEY=your-deepgram-key

# Optional: Deepgram STT model (default nova-3)
DEEPGRAM_STT_MODEL=nova-3
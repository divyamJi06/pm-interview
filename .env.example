# Copy this file to .env and fill in the key for the provider you use.
# The app auto-loads .env from the project root on startup.

# Which provider to use: cohere (default) | openai | groq | anthropic
AI_PROVIDER=cohere

# Set only the line matching AI_PROVIDER:
COHERE_API_KEY=your-cohere-key
OPENAI_API_KEY=your-openai-key
GROQ_API_KEY=your-groq-key
ANTHROPIC_API_KEY=your-anthropic-key

# Optional: override the provider's default model
# COHERE_MODEL=command-a-plus-05-2026
# OPENAI_MODEL=gpt-4.1-mini
# GROQ_MODEL=llama-3.3-70b-versatile
# ANTHROPIC_MODEL=claude-sonnet-5
# AI_MODEL=model-overrides-all-of-the-above

# ---- Voice input (speech-to-text answers) ----
# Which STT provider to use: deepgram (default) | openai | cohere
STT_PROVIDER=deepgram

# Set the key for your chosen STT provider. OPENAI_API_KEY and COHERE_API_KEY
# above are reused here too if the same provider also runs the brain.
DEEPGRAM_API_KEY=your-deepgram-key
# OPENAI_API_KEY=your-openai-key        # reused from AI_PROVIDER=openai
# COHERE_API_KEY=your-cohere-key        # reused from AI_PROVIDER=cohere

# Required for STT_PROVIDER=cohere: Cohere does not auto-detect language.
# ISO-639-1, e.g. "en".
# STT_LANGUAGE=en

# Cohere accepts flac/mp3/mpeg/mpga/ogg/wav — not webm/opus, which is what
# Chrome's MediaRecorder emits. The client converts a webm/opus clip to a
# 16 kHz mono wav before uploading, so cohere works on all browsers; a
# browser that records ogg natively (Firefox) is uploaded as-is.

# Optional: STT model overrides
# DEEPGRAM_STT_MODEL=nova-3
# OPENAI_STT_MODEL=whisper-1
# COHERE_STT_MODEL=cohere-transcribe-03-2026